<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AuroraStudio.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />

    <!-- App-wide tuning: tighter, denser, professional tool look -->
    <Style Selector="Window">
      <Setter Property="Background" Value="#1E1F22"/>
      <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- menus: slim dark bar, readable popups -->
    <Style Selector="Menu">
      <Setter Property="Background" Value="#191A1C"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="#0D0D0F"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="MinHeight" Value="30"/>
    </Style>
    <Style Selector="MenuItem > /template/ Border#Root">
      <Setter Property="MinHeight" Value="30"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Background" Value="#2A2C31"/>
      <Setter Property="MinHeight" Value="27"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#35373E"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#4F8CFF"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="#26282C"/>
      <Setter Property="BorderBrush" Value="#3A3D44"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="MinHeight" Value="27"/>
      <Setter Property="Padding" Value="7,4"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#4A4E57"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#4F8CFF"/>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="27"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Background" Value="#2A2C31"/>
      <Setter Property="Padding" Value="9,3"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="24"/>
    </Style>

    <Style Selector="ToolTip">
      <Setter Property="Background" Value="#26282C"/>
      <Setter Property="Foreground" Value="#D7DADE"/>
      <Setter Property="BorderBrush" Value="#3A3D44"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="9,6"/>
    </Style>

    <!-- scrollbars: thin, unobtrusive -->
    <Style Selector="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
      <Setter Property="MinHeight" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
    </Style>

    <!-- separators inside menus -->
    <Style Selector="Menu > MenuItem > Separator">
      <Setter Property="Background" Value="#33363D"/>
      <Setter Property="Margin" Value="8,4"/>
      <Setter Property="Height" Value="1"/>
    </Style>
  </Application.Styles>

  <Application.Resources>
    <Color x:Key="AccentColor">#4F8CFF</Color>
  </Application.Resources>

</Application>
