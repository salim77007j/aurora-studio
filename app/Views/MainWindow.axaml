<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AuroraStudio.Controls;assembly=AuroraStudio"
        x:Class="AuroraStudio.Views.MainWindow"
        Title="Aurora Studio"
        Width="1440" Height="860" MinWidth="1024" MinHeight="620"
        Background="#1E1F22"
        WindowStartupLocation="Manual">

  <Window.Resources>
    <x:Double x:Key="ToolBtnSize">40</x:Double>
  </Window.Resources>

  <Window.Styles>
    <!-- ═══════ tool palette buttons ═══════ -->
    <Style Selector="Button.toolbtn">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.toolbtn /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.toolbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2E3138"/>
    </Style>
    <Style Selector="Button.toolbtn:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#363B46"/>
    </Style>
    <!-- active tool: tinted background + accent left bar -->
    <Style Selector="Button.toolbtn.active">
      <Setter Property="Background" Value="#2B3A55"/>
    </Style>
    <Style Selector="Button.toolbtn.active /template/ ContentPresenter">
      <Setter Property="Background" Value="#2B3A55"/>
    </Style>

    <!-- ═══════ document tabs ═══════ -->
    <Style Selector="Border.doctab">
      <Setter Property="CornerRadius" Value="6,6,0,0"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="2,3,0,0"/>
    </Style>
    <Style Selector="Border.doctab:pointerover">
      <Setter Property="Background" Value="#232529"/>
    </Style>

    <!-- ═══════ panel section headers ═══════ -->
    <Style Selector="Border.panelHead">
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Background" Value="#232529"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderBrush" Value="#33363D"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="Border.panelHead > TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="1.4"/>
      <Setter Property="Foreground" Value="#9AA0A6"/>
    </Style>

    <!-- ═══════ status bar text ═══════ -->
    <Style Selector="TextBlock.statusTxt">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- menus: compact professional bar -->
    <Style Selector="MenuItem">
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style Selector="MenuItem:open /template/ ContentPresenter">
      <Setter Property="Background" Value="#2E3138"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- ══════════ MENU ══════════ -->
    <Menu Grid.Row="0" x:Name="MainMenu" Background="#191A1C">
      <MenuItem Header="_File">
        <MenuItem Header="New…" Command="{Binding CmdNew}" InputGesture="Ctrl+N"/>
        <MenuItem Header="Open…" Command="{Binding CmdOpen}" InputGesture="Ctrl+O"/>
        <MenuItem x:Name="MnuRecent" Header="Open Recent"/>
        <Separator/>
        <MenuItem Header="Save" Command="{Binding CmdSave}" InputGesture="Ctrl+S"/>
        <MenuItem Header="Export As…" Command="{Binding CmdExport}" InputGesture="Ctrl+Shift+E"/>
        <Separator/>
        <MenuItem Header="Close Document" Command="{Binding CmdCloseDoc}"/>
        <MenuItem Header="Exit" Command="{Binding CmdExit}"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="Undo" Command="{Binding CmdUndo}" InputGesture="Ctrl+Z"/>
        <MenuItem Header="Redo" Command="{Binding CmdRedo}" InputGesture="Ctrl+Y"/>
        <Separator/>
        <MenuItem Header="Fill with Foreground" Command="{Binding CmdFill}"/>
        <MenuItem Header="Clear (Delete)" Command="{Binding CmdClear}" InputGesture="Delete"/>
        <Separator/>
        <MenuItem Header="Keyboard Shortcuts…" Command="{Binding CmdShortcuts}"/>
        <MenuItem Header="Preferences…" Command="{Binding CmdPrefs}"/>
      </MenuItem>
      <MenuItem Header="_Image">
        <MenuItem Header="Image Size…" Command="{Binding CmdImageSize}"/>
        <MenuItem Header="Canvas Size…" Command="{Binding CmdCanvasSize}"/>
        <Separator/>
        <MenuItem Header="Rotate 90° Clockwise" Command="{Binding CmdRot90}"/>
        <MenuItem Header="Rotate 180°" Command="{Binding CmdRot180}"/>
        <MenuItem Header="Rotate 90° Counter-Clockwise" Command="{Binding CmdRot270}"/>
        <Separator/>
        <MenuItem Header="Flip Horizontal" Command="{Binding CmdFlipH}"/>
        <MenuItem Header="Flip Vertical" Command="{Binding CmdFlipV}"/>
        <Separator/>
        <MenuItem Header="Crop to Selection" Command="{Binding CmdCropSel}"/>
        <MenuItem Header="Flatten Image" Command="{Binding CmdFlatten}"/>
      </MenuItem>
      <MenuItem Header="_Layer">
        <MenuItem Header="New Layer" Command="{Binding CmdLayerNew}" InputGesture="Ctrl+Shift+N"/>
        <MenuItem Header="New Group" Command="{Binding CmdLayerGroup}"/>
        <MenuItem Header="Duplicate Layer" Command="{Binding CmdLayerDup}" InputGesture="Ctrl+J"/>
        <MenuItem Header="Delete Layer" Command="{Binding CmdLayerDel}"/>
        <Separator/>
        <MenuItem Header="Add Mask from Selection" Command="{Binding CmdMaskAdd}"/>
        <MenuItem Header="Apply Mask" Command="{Binding CmdMaskApply}"/>
        <MenuItem Header="Delete Mask" Command="{Binding CmdMaskDel}"/>
        <Separator/>
        <MenuItem Header="Merge Down" Command="{Binding CmdMergeDown}" InputGesture="Ctrl+E"/>
        <MenuItem Header="Move Layer Up" Command="{Binding CmdLayerUp}"/>
        <MenuItem Header="Move Layer Down" Command="{Binding CmdLayerDown}"/>
      </MenuItem>
      <MenuItem Header="_Select">
        <MenuItem Header="All" Command="{Binding CmdSelAll}" InputGesture="Ctrl+A"/>
        <MenuItem Header="Deselect" Command="{Binding CmdSelNone}" InputGesture="Ctrl+D"/>
        <MenuItem Header="Invert" Command="{Binding CmdSelInvert}" InputGesture="Ctrl+Shift+I"/>
        <Separator/>
        <MenuItem Header="Feather…" Command="{Binding CmdFeather}"/>
      </MenuItem>
      <MenuItem Header="F_ilter">
        <MenuItem Header="Blur &amp; Sharpness">
          <MenuItem Header="Gaussian Blur…" Command="{Binding CmdFGauss}"/>
          <MenuItem Header="Box Blur…" Command="{Binding CmdFBoxBlur}"/>
          <MenuItem Header="Motion Blur…" Command="{Binding CmdFMotionBlur}"/>
          <MenuItem Header="Zoom Blur…" Command="{Binding CmdFZoomBlur}"/>
          <Separator/>
          <MenuItem Header="Sharpen…" Command="{Binding CmdFSharpen}"/>
          <MenuItem Header="Unsharp Mask…" Command="{Binding CmdFUnsharp}"/>
          <MenuItem Header="Clarity…" Command="{Binding CmdFClarity}"/>
        </MenuItem>
        <MenuItem Header="Distort">
          <MenuItem Header="Twirl…" Command="{Binding CmdFTwirl}"/>
          <MenuItem Header="Wave…" Command="{Binding CmdFWave}"/>
          <MenuItem Header="Ripple…" Command="{Binding CmdFRipple}"/>
          <MenuItem Header="Pinch / Bulge…" Command="{Binding CmdFPinch}"/>
        </MenuItem>
        <MenuItem Header="Stylize">
          <MenuItem Header="Emboss" Command="{Binding CmdFEmboss}"/>
          <MenuItem Header="Find Edges" Command="{Binding CmdFFindEdges}"/>
          <MenuItem Header="Oil Paint…" Command="{Binding CmdFOilPaint}"/>
          <MenuItem Header="Halftone…" Command="{Binding CmdFHalftone}"/>
          <MenuItem Header="Charcoal…" Command="{Binding CmdFCharcoal}"/>
          <MenuItem Header="Pencil Sketch…" Command="{Binding CmdFPencil}"/>
        </MenuItem>
        <MenuItem Header="Effects">
          <MenuItem Header="Vignette…" Command="{Binding CmdFVignette}"/>
          <MenuItem Header="Bloom / Glow…" Command="{Binding CmdFBloom}"/>
          <MenuItem Header="Film Grain…" Command="{Binding CmdFGrain}"/>
          <MenuItem Header="Scanlines (CRT)…" Command="{Binding CmdFScanlines}"/>
          <MenuItem Header="Glitch…" Command="{Binding CmdFGlitch}"/>
          <MenuItem Header="Chromatic Aberration…" Command="{Binding CmdFChromatic}"/>
          <MenuItem Header="Duotone…" Command="{Binding CmdFDuotone}"/>
        </MenuItem>
        <MenuItem Header="Noise">
          <MenuItem Header="Add Noise…" Command="{Binding CmdFNoise}"/>
          <MenuItem Header="Noise Reduction (Median)" Command="{Binding CmdFMedian}"/>
        </MenuItem>
        <MenuItem Header="Render">
          <MenuItem Header="Clouds…" Command="{Binding CmdFClouds}"/>
        </MenuItem>
        <MenuItem Header="Pixelate…" Command="{Binding CmdFPixelate}"/>
      </MenuItem>
      <MenuItem Header="_Colors">
        <MenuItem Header="Auto Enhance" Command="{Binding CmdAutoEnhance}"/>
        <Separator/>
        <MenuItem Header="Auto Tone" Command="{Binding CmdAutoTone}"/>
        <MenuItem Header="Auto Contrast" Command="{Binding CmdAutoContrast}"/>
        <MenuItem Header="Auto Color" Command="{Binding CmdAutoColor}"/>
        <Separator/>
        <MenuItem Header="Brightness / Contrast…" Command="{Binding CmdAdjBC}"/>
        <MenuItem Header="Levels…" Command="{Binding CmdAdjLevels}"/>
        <MenuItem Header="Curves…" Command="{Binding CmdAdjCurves}"/>
        <MenuItem Header="Exposure…" Command="{Binding CmdAdjExposure}"/>
        <MenuItem Header="Shadows / Highlights…" Command="{Binding CmdAdjShadowsHi}"/>
        <Separator/>
        <MenuItem Header="Hue / Saturation…" Command="{Binding CmdAdjHSL}"/>
        <MenuItem Header="Vibrance…" Command="{Binding CmdAdjVibrance}"/>
        <MenuItem Header="White Balance…" Command="{Binding CmdAdjWhiteBalance}"/>
        <MenuItem Header="Color Balance…" Command="{Binding CmdAdjColorBalance}"/>
        <Separator/>
        <MenuItem Header="Black &amp; White…" Command="{Binding CmdAdjBW}"/>
        <MenuItem Header="Photo Filter…" Command="{Binding CmdAdjPhotoFilter}"/>
        <MenuItem Header="Gradient Map…" Command="{Binding CmdAdjGradientMap}"/>
        <MenuItem Header="Threshold…" Command="{Binding CmdAdjThreshold}"/>
        <MenuItem Header="Posterize…" Command="{Binding CmdAdjPosterize}"/>
        <Separator/>
        <MenuItem Header="Invert" Command="{Binding CmdAdjInvert}"/>
        <MenuItem Header="Desaturate" Command="{Binding CmdAdjDesaturate}"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Zoom In" Command="{Binding CmdZoomIn}" InputGesture="Ctrl++"/>
        <MenuItem Header="Zoom Out" Command="{Binding CmdZoomOut}" InputGesture="Ctrl+-"/>
        <MenuItem Header="Fit on Screen" Command="{Binding CmdZoomFit}" InputGesture="Ctrl+0"/>
        <MenuItem Header="Actual Pixels" Command="{Binding CmdZoom100}" InputGesture="Ctrl+1"/>
        <Separator/>
        <MenuItem Header="Workspace">
          <MenuItem Header="Default" Command="{Binding CmdWsDefault}"/>
          <MenuItem Header="Minimal" Command="{Binding CmdWsMinimal}"/>
          <MenuItem Header="Painting" Command="{Binding CmdWsPainting}"/>
          <MenuItem Header="Photo Editing" Command="{Binding CmdWsPhoto}"/>
        </MenuItem>
        <MenuItem Header="Panels">
          <MenuItem x:Name="MnuToggleHistogram" Header="Show Histogram Panel" Command="{Binding CmdToggleHistogram}"/>
          <MenuItem x:Name="MnuToggleNavigator" Header="Show Navigator Panel" Command="{Binding CmdToggleNavigator}"/>
          <MenuItem x:Name="MnuToggleHistory" Header="Show History Panel" Command="{Binding CmdToggleHistory}"/>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="About Aurora Studio" Command="{Binding CmdAbout}"/>
      </MenuItem>
    </Menu>

    <!-- ══════════ TOOL OPTIONS BAR ══════════ -->
    <Border Grid.Row="1" Background="#252629" BorderBrush="#0D0D0F" BorderThickness="0,0,0,1">
      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <ContentControl x:Name="OptionsBar" HorizontalContentAlignment="Left" Margin="10,5"/>
      </ScrollViewer>
    </Border>

    <!-- ══════════ WORK AREA ══════════ -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,4,Auto" x:Name="WorkArea">

      <!-- TOOL PALETTE -->
      <Border Grid.Column="0" Background="#252629" BorderBrush="#0D0D0F" BorderThickness="0,0,1,0" Padding="5,8">
        <ItemsControl x:Name="ToolPalette">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Vertical" Spacing="3"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="toolbtn" Click="OnToolClick" Tag="{Binding}"
                      Classes.active="{Binding IsActive}"
                      ToolTip.Tip="{Binding Tooltip}">
                <Panel>
                  <Path Data="{Binding Geometry}" Stroke="{Binding Foreground}" StrokeThickness="1.6"
                        StrokeLineCap="Round"
                        Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Panel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- CENTER: tabs + canvas -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#1A1B1D" BorderBrush="#0D0D0F" BorderThickness="0,0,0,1">
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="DocTabs" Margin="6,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="doctab" Background="{Binding TabBrush}" Tapped="OnTabTapped">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Foreground="{Binding TabForeground}"/>
                      <TextBlock Text="✕" FontSize="10" Opacity="0.65" VerticalAlignment="Center"
                                 Tapped="OnTabCloseTapped" Cursor="Hand"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <Grid Grid.Row="1">
          <local:CanvasView x:Name="Canvas"/>
          <Canvas x:Name="CanvasOverlay" IsHitTestVisible="False"/>
        </Grid>
      </Grid>

      <!-- splitter between canvas and right dock -->
      <GridSplitter Grid.Column="2" Background="Transparent" ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns" MinWidth="4"/>

      <!-- RIGHT PANELS (resizable, width persisted) -->
      <Border Grid.Column="3" x:Name="RightDock" Background="#252629" BorderBrush="#0D0D0F"
              BorderThickness="1,0,0,0" MinWidth="244" MaxWidth="520" Width="300">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8" Margin="8,8,8,8">
            <ContentControl x:Name="NavigatorPanelHost"/>
            <ContentControl x:Name="ColorPanelHost"/>
            <ContentControl x:Name="HistogramPanelHost"/>
            <ContentControl x:Name="LayersPanelHost"/>
            <ContentControl x:Name="HistoryPanelHost"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ══════════ STATUS BAR ══════════ -->
    <Border Grid.Row="3" Background="#191A1C" BorderBrush="#0D0D0F" BorderThickness="0,1,0,0" Padding="12,4">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
        <TextBlock x:Name="StatusTool" Grid.Column="0" Classes="statusTxt" Foreground="#9AA0A6" Text="Ready"/>
        <TextBlock x:Name="StatusMsg" Grid.Column="1" Classes="statusTxt" Foreground="#6E7378" Margin="16,0" Text=""/>
        <TextBlock x:Name="StatusPos" Grid.Column="2" Classes="statusTxt" Foreground="#9AA0A6" Text=""/>
        <TextBlock x:Name="StatusSel" Grid.Column="3" Classes="statusTxt" Foreground="#9AA0A6" Margin="16,0" Text=""/>
        <TextBlock x:Name="StatusZoom" Grid.Column="4" Classes="statusTxt" Foreground="#9AA0A6" Margin="16,0" Text="100%"/>
        <TextBlock x:Name="StatusSize" Grid.Column="5" Classes="statusTxt" Foreground="#9AA0A6" Margin="16,0" Text=""/>
        <TextBlock x:Name="StatusEngine" Grid.Column="6" Classes="statusTxt" Foreground="#6E7378" Margin="16,0,0,0" Text=""/>
      </Grid>
    </Border>
  </Grid>
</Window>
